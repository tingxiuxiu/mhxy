# ============================================================
# 文字西游 后端配置示例文件
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

# ---------- 应用基础配置 ----------
APP_NAME=文字西游
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
ADMIN_PREFIX=/api/admin

# ---------- 安全配置（生产环境必须修改） ----------
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUEST_SIGN_SECRET=change-me-request-sign-secret

# ---------- 数据库配置 ----------
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/mhxy
DATABASE_ECHO=false

# ---------- Redis配置 ----------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ---------- ID生成配置 ----------
HASHIDS_SALT=change-me-hashids-salt
HASHIDS_MIN_LENGTH=8

# ---------- 接口限流配置 ----------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_IP_PER_MINUTE=200

# ---------- 游戏冷却配置（秒） ----------
MOVE_COOLDOWN_SEC=1
CHAT_WORLD_COOLDOWN_SEC=30
BATTLE_CMD_COOLDOWN_SEC=3
TRADE_COOLDOWN_SEC=10
ENCOUNTER_COOLDOWN_SEC=3

# ---------- 战斗配置 ----------
BATTLE_TURN_TIMEOUT_SEC=45
BATTLE_MAX_ROUNDS=150

# ---------- WebSocket配置 ----------
WS_HEARTBEAT_INTERVAL_SEC=30
WS_HEARTBEAT_TIMEOUT_SEC=90
WS_MAX_MESSAGE_SIZE_KB=4

# ---------- 经济系统配置 ----------
MONEY_CARRY_LIMIT_BASE=100000
MONEY_CARRY_LIMIT_PER_LEVEL=100000
TRADE_LEVEL_LIMIT=30

# ---------- 敏感词（JSON数组格式） ----------
SENSITIVE_WORDS=["赌博","色情","暴力"]
